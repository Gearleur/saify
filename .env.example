# Copier ce fichier en `.env` (ignoré par git, ne jamais le commiter).
# Sans clé, l'outil fonctionne entièrement : les questions sont comprises par mots-clés.

# Clé Anthropic, utilisée uniquement pour comprendre les questions (Claude Haiku 5.5).
ANTHROPIC_API_KEY=

# 0 : coupe le LLM sans retirer la clé (repli par mots-clés). Les tests le forcent à 0.
LLM_ACTIF=1

# Date d'arrêté exigée des fichiers déposés. Vide : celle lue dans le PMS (démo sur les fichiers
# du 25/09). « auto » en production : J-1 ouvré (calendrier TARGET2), des fichiers périmés sont
# refusés. Ou une date fixe AAAA-MM-JJ.
DATE_ARRETE_ATTENDUE=
